rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yetkilendirme fonksiyonları
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      let sirketData = get(/databases/$(database)/documents/sirketler/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirketId)).data;
      return isAuthenticated() && (
        sirketData.yoneticiEposta == request.auth.token.email
        || ('adminlar' in sirketData && request.auth.uid in sirketData.adminlar && sirketData.adminlar[request.auth.uid] == true)
      );
    }

    function userSirketId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirketId;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // Kullanıcının sirketId'si var mı kontrol et
    // exists() kontrolü ile yeni kayıt olan kullanıcıların doc'u yoksa hata vermesini engeller
    function hasUserSirketId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'sirketId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirketId != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirketId != '';
    }

    function protectedUserFields() {
      return [
        'companyCreationPaid',
        'paidAt',
        'productId',
        'transactionId',
        'subscriptionType',
        'subscriptionEndDate',
        'autoRenew',
        'trialUsed',
        'trialStartDate',
        'lastPurchaseStatus'
      ];
    }

    function canReadProject(projectId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && (
        (
          hasUserSirketId()
          && (
            get(/databases/$(database)/documents/projects/$(projectId)).data.companyId == userSirketId()
            || (
              'sirketId' in get(/databases/$(database)/documents/projects/$(projectId)).data
              && get(/databases/$(database)/documents/projects/$(projectId)).data.sirketId == userSirketId()
            )
          )
        )
        || (
          'paylasilanEmailler' in get(/databases/$(database)/documents/projects/$(projectId)).data
          && userEmail() in get(/databases/$(database)/documents/projects/$(projectId)).data.paylasilanEmailler
        )
      );
    }

    function canWriteProject(projectId) {
      return isAuthenticated()
        && hasUserSirketId()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.companyId == userSirketId()
          || (
            'sirketId' in get(/databases/$(database)/documents/projects/$(projectId)).data
            && get(/databases/$(database)/documents/projects/$(projectId)).data.sirketId == userSirketId()
          )
        );
    }

    // Users koleksiyonu
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId);
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(protectedUserFields());
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Payments koleksiyonu
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Şirketler koleksiyonu
    match /sirketler/{sirketId} {
      allow create: if isAuthenticated();
      // sirketId varsa normal erişim, yoksa email eşleşmesi ile okumaya izin ver
      allow read: if isAuthenticated() && (
        (hasUserSirketId() && userSirketId() == sirketId)
        || ('emailler' in resource.data && request.auth.token.email in resource.data.emailler)
      );
      allow write: if isAdmin() && userSirketId() == sirketId;

      // Bildirimler alt koleksiyonu
      match /bildirimler/{bildirimId} {
        allow read, write: if isAuthenticated() && hasUserSirketId() && userSirketId() == sirketId;
      }

      // Sistem alt koleksiyonu (pasif kontrol vb.)
      match /sistem/{docId} {
        allow read, write: if isAuthenticated() && hasUserSirketId() && userSirketId() == sirketId;
      }
    }

    // Cari Hesaplar
    match /cari_hesaplar/{cariId} {
      allow read: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
      allow create: if isAuthenticated() && hasUserSirketId() && request.resource.data.sirketId == userSirketId();
      allow update, delete: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();

      match /hareketler/{hareketId} {
        allow read, write: if isAuthenticated()
          && hasUserSirketId()
          && get(/databases/$(database)/documents/cari_hesaplar/$(cariId)).data.sirketId == userSirketId();
      }

      match /taksit_planlari/{planId} {
        allow read, write: if isAuthenticated()
          && hasUserSirketId()
          && get(/databases/$(database)/documents/cari_hesaplar/$(cariId)).data.sirketId == userSirketId();

        match /taksitler/{taksitId} {
          allow read, write: if isAuthenticated()
            && hasUserSirketId()
            && get(/databases/$(database)/documents/cari_hesaplar/$(cariId)).data.sirketId == userSirketId();
        }
      }
    }

    // Projeler koleksiyonu
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        (
          hasUserSirketId()
          && (
            resource.data.companyId == userSirketId()
            || ('sirketId' in resource.data && resource.data.sirketId == userSirketId())
          )
        )
        || ('paylasilanEmailler' in resource.data && request.auth.token.email in resource.data.paylasilanEmailler)
      );
      allow create: if isAuthenticated() && hasUserSirketId() && (
        request.resource.data.companyId == userSirketId()
        || ('sirketId' in request.resource.data && request.resource.data.sirketId == userSirketId())
      );
      allow update, delete: if isAuthenticated() && hasUserSirketId() && (
        resource.data.companyId == userSirketId()
        || ('sirketId' in resource.data && resource.data.sirketId == userSirketId())
      );

      match /phases/{phaseId} {
        allow read, write: if hasUserSirketId() && get(/databases/$(database)/documents/projects/$(projectId)).data.companyId == userSirketId();
      }

      match /transactions/{transactionId} {
        allow read, write: if hasUserSirketId() && get(/databases/$(database)/documents/projects/$(projectId)).data.companyId == userSirketId();
      }
    }

    // Proje Finansmanı
    match /project_finance/{projectId} {
      allow read: if canReadProject(projectId);
      allow write: if canWriteProject(projectId);

      match /transactions/{transactionId} {
        allow read: if canReadProject(projectId);
        allow write: if canWriteProject(projectId);
      }
    }

    // Proje Aşamaları
    match /project_phases/{projectId} {
      allow read: if canReadProject(projectId);
      allow write: if canWriteProject(projectId);
    }

    // Şirket Finansmanı
    match /company_finance/{companyId} {
      allow read: if isAuthenticated() && hasUserSirketId() && userSirketId() == companyId;
      allow write: if isAuthenticated() && hasUserSirketId() && userSirketId() == companyId;
    }

    // Teklifler
    match /teklifler/{teklifId} {
      allow read: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
      allow create: if isAuthenticated() && hasUserSirketId() && request.resource.data.sirketId == userSirketId();
      allow update, delete: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();

      match /gelirler/{gelirId} {
        allow read, write: if isAuthenticated()
          && hasUserSirketId()
          && get(/databases/$(database)/documents/teklifler/$(teklifId)).data.sirketId == userSirketId();
      }
      match /giderler/{giderId} {
        allow read, write: if isAuthenticated()
          && hasUserSirketId()
          && get(/databases/$(database)/documents/teklifler/$(teklifId)).data.sirketId == userSirketId();
      }
      match /odemeler/{odemeId} {
        allow read, write: if isAuthenticated()
          && hasUserSirketId()
          && get(/databases/$(database)/documents/teklifler/$(teklifId)).data.sirketId == userSirketId();
      }
    }

    // Teklif Arşivi
    match /teklif_arsivi/{arsivId} {
      allow read: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
      allow create: if isAuthenticated() && hasUserSirketId() && request.resource.data.sirketId == userSirketId();
      allow update, delete: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
    }

    // Giderler (global)
    match /giderler/{giderId} {
      allow read: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
      allow create: if isAuthenticated() && hasUserSirketId() && request.resource.data.sirketId == userSirketId();
      allow update, delete: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
    }

    // Gelirler (global)
    match /gelirler/{gelirId} {
      allow read: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
      allow create: if isAuthenticated() && hasUserSirketId() && request.resource.data.sirketId == userSirketId();
      allow update, delete: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
    }

    // Audit Log
    match /auditLog/{logId} {
      allow read: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
      allow create: if isAuthenticated()
        && hasUserSirketId()
        && request.resource.data.sirketId == userSirketId()
        && request.resource.data.email == userEmail();
      allow update, delete: if false;
    }

    // Görevler (task assignment)
    match /gorevler/{gorevId} {
      allow read: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
      allow create: if isAuthenticated() && hasUserSirketId() && request.resource.data.sirketId == userSirketId();
      allow update, delete: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
    }

    // Günlük Raporlar (sabah 07:00'da Cloud Function tarafından yazılır)
    match /gunluk_raporlar/{raporId} {
      allow read: if isAuthenticated() && hasUserSirketId() && resource.data.sirketId == userSirketId();
      allow write: if false; // Sadece Cloud Function yazabilir
    }

    // Ödeme Planları
    match /payment_plans/{planId} {
      allow read, write: if false;
    }

    // Taksitler
    match /payment_installments/{installmentId} {
      allow read, write: if false;

      match /payment_records/{recordId} {
        allow read, write: if false;
      }
    }

    // Ruhsat Dosyaları
    match /ruhsat/{projectId} {
      allow read: if canReadProject(projectId);
      allow write: if canWriteProject(projectId);

      match /islemler/{islemId} {
        allow read: if canReadProject(projectId);
        allow write: if canWriteProject(projectId);
      }
      match /akis_diyagrami/{docId} {
        allow read: if canReadProject(projectId);
        allow write: if canWriteProject(projectId);
      }
      match /belgeler/{belgeId} {
        allow read: if canReadProject(projectId);
        allow write: if canWriteProject(projectId);
      }
    }

    // Şantiye Dosyaları
    match /santiye/{projectId} {
      allow read: if canReadProject(projectId);
      allow write: if canWriteProject(projectId);

      match /islemler/{islemId} {
        allow read: if canReadProject(projectId);
        allow write: if canWriteProject(projectId);
      }
      match /fotograflar/{fotoId} {
        allow read: if canReadProject(projectId);
        allow write: if canWriteProject(projectId);
      }
    }

    // Diğer koleksiyonlar
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
