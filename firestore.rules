rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yetkilendirme fonksiyonları
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/sirketler/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirketId)).data.adminlar[request.auth.uid] == true;
    }

    function userSirketId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirketId;
    }

    // Users koleksiyonu
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId);
      allow write: if isAuthenticated() && (request.auth.uid == userId);
    }

    // Şirketler koleksiyonu
    match /sirketler/{sirketId} {
      allow read: if isAuthenticated() && userSirketId() == sirketId;
      allow write: if isAdmin() && userSirketId() == sirketId;
    }

    // Projeler koleksiyonu
    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.companyId == userSirketId();
      allow create: if isAuthenticated() && request.resource.data.companyId == userSirketId();
      allow update, delete: if isAdmin() && resource.data.companyId == userSirketId();

      // Proje Aşamaları
      match /phases/{phaseId} {
        allow read, write: if get(/databases/$(database)/documents/projects/$(projectId)).data.companyId == userSirketId();
      }

      // Finansal İşlemler
      match /transactions/{transactionId} {
        allow read, write: if get(/databases/$(database)/documents/projects/$(projectId)).data.companyId == userSirketId();
      }
    }

    // Proje Finansmanı
    match /project_finance/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && exists(/databases/$(database)/documents/projects/$(projectId));

      match /transactions/{transactionId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Proje Aşamaları
    match /project_phases/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Şirket Finansmanı
    match /company_finance/{companyId} {
      allow read: if isAuthenticated() && userSirketId() == companyId;
      allow write: if isAdmin() && userSirketId() == companyId;
    }

    // Teklifler
    match /teklifler/{teklifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.sirket == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirket;
    }

    // Teklif Arşivi
    match /teklif_arsivi/{arsivId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Diğer koleksiyonlar
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
