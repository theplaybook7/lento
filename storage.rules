rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated users can read/write upload paths
    match /ruhsat_belgeler/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /santiye_fotograflar/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /cari_hareketler/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /sirket_logolar/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
