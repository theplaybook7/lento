# Firebase Cloud Functions - Ortam Değişkenleri
# Dosya: .env.local (çalışmayan klasörde)
# Veya Firebase CLI ile: firebase functions:config:set

# Apple App Store Configuration  
APPLE_APP_PASSWORD="xxxxxxxx"  # App-specific password for App Store
APPLE_TEAM_ID="xxxxxxxxx"

# Google Play Configuration
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='path/to/service-account.json'

# Email Configuration (iletişim için)
SENDGRID_API_KEY="SG.xxxxx"
ADMIN_EMAIL="admin@insaat-yonetim.com"

# App URLs
APP_SUCCESS_URL="https://yourapp.com/payment-success"
APP_CANCEL_URL="https://yourapp.com/payment-cancel"

# İyzico Configuration (Türkiye özel - isteğe bağlı)
IYZICO_API_KEY="xxx"
IYZICO_SECRET_KEY="xxx"
IYZICO_BASE_URL="https://api.iyzipay.com"
