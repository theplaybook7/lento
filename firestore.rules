rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yetkilendirme fonksiyonları
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      let sirketData = get(/databases/$(database)/documents/sirketler/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirketId)).data;
      return isAuthenticated() && (
        sirketData.yoneticiEposta == request.auth.token.email
        || ('adminlar' in sirketData && request.auth.uid in sirketData.adminlar && sirketData.adminlar[request.auth.uid] == true)
      );
    }

    function userSirketId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sirketId;
    }

    // Users koleksiyonu
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId);
      allow write: if isAuthenticated() && (request.auth.uid == userId);
    }

    // Payments koleksiyonu
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated();
    }

    // Şirketler koleksiyonu
    match /sirketler/{sirketId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && userSirketId() == sirketId;
      allow write: if isAdmin() && userSirketId() == sirketId;

      // Bildirimler alt koleksiyonu
      match /bildirimler/{bildirimId} {
        allow read, write: if isAuthenticated() && userSirketId() == sirketId;
      }
    }

    // Cari Hesaplar
    match /cari_hesaplar/{cariId} {
      allow read: if isAuthenticated() && resource.data.sirketId == userSirketId();
      allow create: if isAuthenticated() && request.resource.data.sirketId == userSirketId();
      allow update, delete: if isAuthenticated() && resource.data.sirketId == userSirketId();

      match /hareketler/{hareketId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Projeler koleksiyonu
    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.companyId == userSirketId();
      allow create: if isAuthenticated() && request.resource.data.companyId == userSirketId();
      allow update, delete: if isAuthenticated() && resource.data.companyId == userSirketId();

      match /phases/{phaseId} {
        allow read, write: if get(/databases/$(database)/documents/projects/$(projectId)).data.companyId == userSirketId();
      }

      match /transactions/{transactionId} {
        allow read, write: if get(/databases/$(database)/documents/projects/$(projectId)).data.companyId == userSirketId();
      }
    }

    // Proje Finansmanı
    match /project_finance/{projectId} {
      allow read, write: if isAuthenticated();

      match /transactions/{transactionId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Proje Aşamaları
    match /project_phases/{projectId} {
      allow read, write: if isAuthenticated();
    }

    // Şirket Finansmanı
    match /company_finance/{companyId} {
      allow read: if isAuthenticated() && userSirketId() == companyId;
      allow write: if isAuthenticated() && userSirketId() == companyId;
    }

    // Teklifler
    match /teklifler/{teklifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();

      match /gelirler/{gelirId} {
        allow read, write: if isAuthenticated();
      }
      match /giderler/{giderId} {
        allow read, write: if isAuthenticated();
      }
      match /odemeler/{odemeId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Teklif Arşivi
    match /teklif_arsivi/{arsivId} {
      allow read, write: if isAuthenticated();
    }

    // Giderler (global)
    match /giderler/{giderId} {
      allow read, write: if isAuthenticated();
    }

    // Gelirler (global)
    match /gelirler/{gelirId} {
      allow read, write: if isAuthenticated();
    }

    // Audit Log
    match /auditLog/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Ödeme Planları
    match /payment_plans/{planId} {
      allow read, write: if isAuthenticated();
    }

    // Taksitler
    match /payment_installments/{installmentId} {
      allow read, write: if isAuthenticated();

      match /payment_records/{recordId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Ruhsat Dosyaları
    match /ruhsat/{projectId} {
      allow read, write: if isAuthenticated();

      match /islemler/{islemId} {
        allow read, write: if isAuthenticated();
      }
      match /belgeler/{belgeId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Şantiye Dosyaları
    match /santiye/{projectId} {
      allow read, write: if isAuthenticated();

      match /islemler/{islemId} {
        allow read, write: if isAuthenticated();
      }
      match /fotograflar/{fotoId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Diğer koleksiyonlar
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
